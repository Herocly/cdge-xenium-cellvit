def: "Any microvascular endothelial cell that is part of a endometrial blood vessel." [GOC:TermGenie]
is_a: CL:0009095 ! endothelial cell of uterus
is_a: CL:2000008 ! microvascular endothelial cell

[Term]
id: CL:2000092
