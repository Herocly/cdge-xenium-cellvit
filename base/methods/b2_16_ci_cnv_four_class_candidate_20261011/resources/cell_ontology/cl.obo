[Term]
id: CL:4033041
name: CCL3-positive alveolar macrophage
def: "An alveolar macrophage that expresses CCL3." [PMID:37291214]
synonym: "alveolar macrophage CCL3-positive" EXACT [PMID:37291214]
is_a: CL:0000583 ! alveolar macrophage

