is_a: CL:0000130 ! neuron associated cell (sensu Nematoda and Protostomia)

[Term]
id: CL:0000144
name: obsolete cell by function
def: "OBSOLETE: A classification of cells by their primary end goal or behavior." [FB:ma]
is_obsolete: true

[Term]
id: CL:0000145
